# Fence AI configuration — copy this file to `.env` and fill in your values.
# The real `.env` is gitignored and must NEVER be committed (it holds your key).
# Real environment variables always override values from this file.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# AI mode: "stub" (offline, default) or "claude" (live interpretation)
FENCEAI_AI=claude

# Model for the Claude adapter (default claude-opus-5; cheaper: claude-sonnet-5)
#FENCEAI_AI_MODEL=claude-sonnet-5

# SQLite database path (default fenceai.db)
#FENCEAI_DB=fenceai.db
